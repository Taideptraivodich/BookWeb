@model BookWeb.Models.Order
@using BookWeb.Models
@{
	ViewData["Title"] = "Đơn hàng #" + Model.Id;
	@*truyền dữ liệu Status tiếp theo vào nexstatus*@
	var nextStatuses = OrderStatus.NextStatuses(Model.Status);
}
@*Cho hiện cái TempData từ action Update gửi qua*@
@if(TempData["Success"] != null)
{
	<div class="alert alert-success">@TempData["Success"]</div>
}

@if(TempData["Error"] != null)
{
	<div class="alert alert-danger">@TempData["Error"]</div>
}

@*Render đơn chi tiết*@
<h2>Đơn hàng #@Model.Id <partial name="_StatusBadge" model="Model.Status" /></h2>

<p class="text-muted">
	Đặt lúc @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
	· Tài khoản: @Model.User?.UserName
</p>

<div class="row mb-4">
	<div class="col-md-6">
		<h5>Thông tin giao hàng</h5>
		<p class="mb-1">@Model.CustomerName</p>
		<p class="mb-1">@Model.Phone</p>
		<p class="mb-1">@Model.Address</p>
		@if(!string.IsNullOrEmpty(Model.Note))
		{
			<p class="text-muted">Ghi chú: @Model.Note</p>
		}
	</div>

	<div class="col-md-6">
		<h5>Xử lý đơn</h5>
		@*nextStatus chỉ không có khi hoàn thành đơn*@
		@if (!nextStatuses.Any())
		{
			<p class="text-muted">Đơn hàng đã kết thúc, không thể đổi trạng thái.</p>
		}
		else
		{
			<div class="d-flex gap-2">
				@*status tiếp theo thường chứa status tiếp theo và cả cancelled*@
				@foreach (var next in nextStatuses)
				{
					@*form này gửi dữ liệu về updatestatus*@
					<form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
						@*input ẩn này sau 2 lần lặp sẽ có 2 input đi cùng với 2 button tương ứng
						*@
						<input type="hidden" name="newStatus" value="@next" />
						@if(next == OrderStatus.Cancelled)
							{
								<button type="submit" class="btn btn-outline-danger" 
								@*cái confirm là hiện ra cái bảng alert trên trình duyệt thôi hiện 1 lần chứ k có gì*@
									onclick="return confirm('Huỷ đơn này và hoàn lại số lượng vào kho?')">
									@next
								</button>
							}
							else
							{
								<button type="submit" class="btn btn-success">→ @next</button>
							}
						</form>
				}
			</div>
		}
	</div>
</div>

@*Dưới này thì đơn giản là render ra cái thông tin order details thôi*@
<table class="table">
	<thead>
		<tr>
			<th>Sách</th>
			<th>Đơn giá</th>
			<th>Số lượng</th>
			<th>Thành tiền</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var d in Model.Details)
		{
			<tr>
				<td>@d.BookTitle</td>
				<td>@d.UnitPrice.ToString("N0") đ</td>
				<td>@d.Quantity</td>
				<td>@d.SubTotal.ToString("N0") đ</td>
			</tr>
		}
	</tbody>
	<tfoot>
		<tr>
			<th colspan="3" class="text-end">Tổng cộng</th>
			<th class="text-danger">@Model.Total.ToString("N0") đ</th>
		</tr>
	</tfoot>
</table>
<a asp-action="Index" class="btn btn-outline-secondary">Về danh sách đơn</a>