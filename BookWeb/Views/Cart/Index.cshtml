@model BookWeb.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2 class="mb-4">Giỏ hàng</h2>

@if(!Model.Lines.Any())
{
    <div class="alert alert-info">Giỏ hàng đang trống</div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-success">Tiếp tục mua sắm</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Sách</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiến</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var line in Model.Lines)
            {
                <tr>
                    <td>
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@line.Book.Id"
                        class="text-decoration-none text-dark">
                            @if(!string.IsNullOrEmpty(line.Book.ImageUrl))
                                {
                                    <img src="@line.Book.ImageUrl" alt="@line.Book.Title"
                                        style="height: 60px;" class="me-2" />
                                }
                                @line.Book.Title
                            </a>
                    </td>
                    <td>@line.Book.Price.ToString("N0") đ</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-1">
                            <input type="hidden" name="bookId" value="@line.Book.Id" />
                            <input type="number" name="quantity" value="@line.Quantity"
                                min="0" max="@line.Book.Stock"
                                class="form-control form-control-sm" style="width: 80px;" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Cập nhật</button>
                        </form>
                    </td>
                    <td>@line.SubTotal.ToString("N0") đ</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="bookId" value="@line.Book.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xoá</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tổng cộng</th>
                <th class="text-danger fs-5">@Model.Total.ToString("N0") đ</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <a asp-action="Checkout" class="btn btn-success">Đặt hàng</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">Tiếp tục mua sắm</a>
}