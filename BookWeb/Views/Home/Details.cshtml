@using BookWeb.Models
@model Book
@{
    ViewData["Title"] = Model.Title;
    var related = ViewBag.Related as List<Book> ?? new();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item">
            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.Name</a>
        </li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-md-4">
        @if(!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm" />
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center text-muted rounded" style="height: 360px;">
                <i class="bi bi-book" style="font-size: 4rem;"></i>
            </div>
        }
    </div>
</div>

<div class="col-md-8">
    <span class="badge bg-success mb-2">@Model.Category?.Name</span>
    <h2>@Model.Title</h2>
    <p class="text-muted">Tác giả: @Model.Author</p>
    <p class="fs-3 fw-bold text-danger">@Model.Price.ToString("N0") đ</p>

    @if(Model.Stock > 0)
    {
        <p class="text-success">Còn hàng (@Model.Stock cuốn)</p>
    }
    else
    {
        <p class="text-secondary">Hết hàng</p>
    }
    @if(Model.Stock > 0)
    {
        <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-center mt-3">
            <input type="hidden" name="bookId" value="@Model.Id" />
            <input type="number" name="quantity" value="1" min="1" max="Model.Stock" class="form-control" style="width: 90px;"/>
            <button type="submit" class="btn btn-sm btn-outline-success">Thêm vào giỏ</button>
        </form>
    }
    <h5 class="mt-4">Mô tả</h5>
    <p style="white-space: pre-line;">@Model.Description</p>
</div>

@if(related.Any())
{
    <h4 class="mt-5 mb-3">Sách cùng danh mục</h4>
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var b in related)
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@b.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                        @if(!string.IsNullOrEmpty(b.ImageUrl))
                            {
                                <img src="@b.ImageUrl" alt="b.Title" class="card-img-top"
                                    style="height: 180px; object-fit: cover;" />
                            }
                            <div class="card-body p-2">
                                <div class="small fw-semibold">@b.Title</div>
                                <div class="small text-danger">@b.Price.ToString("N0") đ</div>
                            </div>
                        </div>
                </a>
            </div>
        }
    </div>
}
