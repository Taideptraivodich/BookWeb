@using Microsoft.AspNetCore.Routing
@model BookWeb.Models.IPagedResult

@if(Model.TotalPages > 1)
{
	var action = ViewContext.RouteData.Values["action"]?.ToString();
	var controller = ViewContext.RouteData.Values["controller"]?.ToString();

	string PageUrl(int p)
	{
		var values = new RouteValueDictionary();
		foreach(var kv in Context.Request.Query)
		{
			if(kv.Key != "page")
			{
				values[kv.Key] = kv.Value.ToString();
			}
		}
		values["page"] = p;
		return Url.Action(action, controller, values) ?? "#";
	}
	var start = Math.Max(1, Model.Page - 2);
	var end = Math.Min(Model.TotalPages, Model.Page + 2);

	<nav aria-label="Phân trang">
		<ul class="pagination justify-content-center mb-1">
			<li class="page-item @(Model.Page == 1 ? "disabled" : "")">
				<a class="page-link" href="@PageUrl(Math.Max(1, Model.Page -1))">&laquo;</a>
			</li>

			@if(start > 1)
			{
				<li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
				@if(start > 2)
				{
					<li class="page-item disabled"><span class="page-link">...</span></li>
				}
			}

			@for (var p = start; p <= end; p++)
			{
				<li class="page-item @(p == Model.Page ? "Active" : "")">
					<a class="page-link" href="@PageUrl(p)">@p</a>
				</li>
			}

			@if(end < Model.TotalPages)
			{
				@if(end < Model.TotalPages - 1)
				{
					<li class="page-item disabled">
						<span class="page-link">...</span>
					</li>
				}
				<li class="page-item">
					<a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a>
				</li>
			}

			<li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
				<a class="page-link" href="@PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&raquo;</a>
			</li>
		</ul>
	</nav>
	<p class="text-center text-muted small">Trang @Model.Page / @Model.TotalPages · @Model.TotalItems kết quả</p>
}
