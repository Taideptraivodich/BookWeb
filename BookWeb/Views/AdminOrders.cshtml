@model List<BookWeb.Models.Order>
@using BookWeb.Models
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var currentStatus = ViewBag.Status as string;
}

<h2 class="mb-4">Quản lý đơn hàng</h2>
<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
            placeholder="Mã đơn, tên người nhận hoặc số điện thoại..." />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">Tất cả trạng thái</option>
            @foreach (var s in OrderStatus.All)
                {
                    <option value="@s" selected ="@(currentStatus == s)">@s</option>
                }
            </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-success">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xoá lọc</a>
    </div>
</form>
@if(!Model.Any())
{
    <div class="alert alert-info">Không có đơn hàng nào.</div>
}
else
{
    <table class="table table-stripted align-middle">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Ngày đặt hàng</th>
                <th>Người nhận</th>
                <th>Điện thoại</th>
                <th>Tổng tiền</th>
            </tr>
        </thead>
    </table>
}