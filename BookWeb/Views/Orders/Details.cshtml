@model BookWeb.Models.Order
@{
    ViewData["Title"] = "Đơn hàng #" + Model.Id;
}

@if(TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<h2>Đơn hàng #@Model.Id</h2>
<p class="text-muted">Đặt lúc @Model.OrderDate.ToString("dd/MM/yyyy HH:mm") · Trạng thái: <strong>@Model.Status</strong></p>

<div class="row mb-4">
    <div class="col-md-6">
        <h5>Thông tin giao hàng</h5>
        <p class="mb-1">@Model.CustomerName</p>
        <p class="mb-1">@Model.Phone</p>
        <p class="mb-1">@Model.Address</p>
        @if(!string.IsNullOrEmpty(Model.Note))
        {
            <p class="text-muted">Ghi chú: @Model.Note</p>
        }
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Sách</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var d in Model.Details)
        {
            <tr>
                <td>@d.BookTitle</td>
                <td>@d.UnitPrice.ToString("N0") đ</td>
                <td>@d.Quantity</td>
                <td>@d.SubTotal.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Tổng cộng</th>
            <th class="text-danger">@Model.Total.ToString("N0") đ</th>
        </tr>
    </tfoot>
</table>
<a asp-action="Index" class="btn btn-outline-secondary">Về danh sách đơn</a>