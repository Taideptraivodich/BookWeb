@model List<BookWeb.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<h2 class="mb-4">Đơn hàng của tôi</h2>
@if(!Model.Any())
{
    <div class="alert alert-info">Bạn chưa có đơn hàng nào</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                @foreach(var order in Model)
                {                    
                    <td>#@order.Id</td>
                    <td>#@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>#@order.Total.ToString("N0") đ</td>
                    <td>@order.Status</td>
                    <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-success">Chi tiết</a></td>
                }
            </tr>
        </tbody>
    </table>
}